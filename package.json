{
  "name": "@vuepress/ecosystem",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run -r --stream build && pnpm run build:style",
    "build:style": "pnpm -r --parallel --stream run style",
    "bundle": "cross-env NODE_ENV=production pnpm run -r --stream build && pnpm run build:style",
    "clean": "pnpm -r --parallel --stream run clean",
    "format": "oxfmt",
    "lint": "oxlint --fix && stylelint **/*.{css,html,scss,vue} --fix && oxfmt",
    "lint:check": "oxlint && stylelint **/*.{css,html,scss,vue} && oxfmt --check",
    "pkg:check-update": "pnpm dlx npm-check-updates",
    "pkg:update": "pnpm up -r",
    "prepare": "husky",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:cov": "cross-env TZ=Etc/UTC vitest run --coverage",
    "test:e2e": "pnpm run --filter ecosystem-e2e e2e:dev && pnpm run --filter ecosystem-e2e e2e:build",
    "test:unit": "cross-env TZ=Etc/UTC vitest run",
    "type:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@lerna-lite/cli": "^5.6.4",
    "@lerna-lite/publish": "^5.6.4",
    "@mr-hope/verify-commit-message": "0.1.1",
    "@tsdown/css": "^0.23.2",
    "@types/node": "^22.20.5",
    "@types/webpack-env": "^1.18.8",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vuepress/test-utils": "workspace:*",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cross-env": "^10.1.0",
    "cssnano": "^9.9.0",
    "happy-dom": "^21.0.4",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "nano-staged": "^1.0.2",
    "oxc-config-hope": "^0.3.15",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "picocolors": "^1.1.1",
    "postcss-html": "^2.0.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "sass-embedded": "catalog:",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-hope": "^12.1.0",
    "stylelint-config-html": "^2.0.0",
    "tsconfig-vuepress": "^7.0.0",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "uglify-js": "^3.19.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vuepress": "catalog:"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{cjs,js,ts,vue}": "oxlint --fix",
    "*.{css,scss,html,vue}": "stylelint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.12.1",
      "onFail": "error"
    }
  }
}
