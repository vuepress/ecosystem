{
  "name": "@vuepress/theme-default",
  "version": "2.0.0-rc.142",
  "description": "Default theme of VuePress",
  "keywords": [
    "default",
    "theme",
    "vitepress",
    "vuepress",
    "vuepress-theme"
  ],
  "homepage": "https://ecosystem.vuejs.press/themes/default/",
  "bugs": {
    "url": "https://github.com/vuepress/ecosystem/issues"
  },
  "license": "MIT",
  "author": "VuePress Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuepress/ecosystem.git",
    "directory": "themes/theme-default"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE.vitepress",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/client/**/*.css"
  ],
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./templates/*": "./templates/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist"
  },
  "dependencies": {
    "@vuepress/helper": "workspace:*",
    "@vuepress/plugin-active-header-links": "workspace:*",
    "@vuepress/plugin-back-to-top": "workspace:*",
    "@vuepress/plugin-copy-code": "workspace:*",
    "@vuepress/plugin-git": "workspace:*",
    "@vuepress/plugin-icon": "workspace:*",
    "@vuepress/plugin-links-check": "workspace:*",
    "@vuepress/plugin-markdown-ext": "workspace:*",
    "@vuepress/plugin-markdown-hint": "workspace:*",
    "@vuepress/plugin-markdown-raw": "workspace:*",
    "@vuepress/plugin-markdown-tab": "workspace:*",
    "@vuepress/plugin-medium-zoom": "workspace:*",
    "@vuepress/plugin-nprogress": "workspace:*",
    "@vuepress/plugin-seo": "workspace:*",
    "@vuepress/plugin-shiki": "workspace:*",
    "@vuepress/plugin-sitemap": "workspace:*",
    "@vuepress/plugin-theme-data": "workspace:*",
    "@vuepress/theme-helper": "workspace:*",
    "@vueuse/core": "catalog:",
    "markdown-it": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@volar/typescript": "^2.4.31",
    "@vue/language-core": "^3.3.14",
    "vue-sfc-transformer": "^0.3.5"
  },
  "peerDependencies": {
    "vuepress": "catalog:"
  }
}
