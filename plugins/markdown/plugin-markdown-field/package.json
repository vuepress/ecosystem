    "clean": "rimraf ./dist"
  },
  "dependencies": {
    "@mdit-vue/shared": "^3.0.2",
    "@mdit/helper": "^1.1.2",
    "@mdit/plugin-field": "^3.0.0",
    "@types/markdown-it": "catalog:",
    "@vuepress/helper": "workspace:*"
  },
  "devDependencies": {
    "markdown-it": "catalog:"
