{
  "name": "@vuepress/plugin-markdown-file-tree",
  "version": "2.0.0-rc.135",
  "description": "VuePress plugin - markdown file tree and code tree",
  "keywords": [
    "code-tree",
    "file-tree",
    "markdown",
    "plugin",
    "vuepress",
    "vuepress-plugin"
  ],
  "homepage": "https://ecosystem.vuejs.press/plugins/markdown/markdown-file-tree.html",
  "bugs": {
    "url": "https://github.com/vuepress/ecosystem/issues"
  },
  "license": "MIT",
  "author": {
    "name": "pengzhanbo",
    "email": "q942450674@qq.com",
    "url": "https://github.com/pengzhanbo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuepress/ecosystem.git",
    "directory": "plugins/markdown/plugin-markdown-file-tree"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist",
    "generate:icons": "unrun scripts/generateFileIcons.ts"
  },
  "dependencies": {
    "@mdit/plugin-container": "^2.0.2",
    "@types/markdown-it": "catalog:",
    "@vuepress/helper": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/vscode-icons": "^1.2.81",
    "@vuepress/highlighter-helper": "workspace:*",
    "@yutengjing/vscode-icons": "^0.1.1",
    "markdown-it": "catalog:"
  },
  "peerDependencies": {
    "vuepress": "catalog:"
  }
}
